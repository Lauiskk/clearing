# Every variable here is OPTIONAL. Each has a default that works with the
# docker-compose stack, so a fresh clone runs with no .env at all.
#
# Copy to .env for values specific to your machine. .env is gitignored.

# --- Postgres -------------------------------------------------------------
# The compose stack publishes 5432. Set PGPORT if you already have a Postgres
# on that port; the machine this was written on runs a system one on 5433.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres

# --- Service ports --------------------------------------------------------
# Everything is published on 127.0.0.1 only. A clone that cannot start because
# a port is busy is a clone nobody runs, so each one is overridable.
LEDGER_PORT=4010
